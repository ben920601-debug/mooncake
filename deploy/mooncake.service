[Unit]
Description=Mooncake BBQ Map (中秋烤肉地圖)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
# .env 由 app.py 自己讀取；這裡的設定優先
Environment=PYTHONUNBUFFERED=1
Environment=BEHIND_PROXY=1
Environment=PORT=__PORT__
ExecStart=__APP_DIR__/.venv/bin/gunicorn -c __APP_DIR__/gunicorn.conf.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

# 基本的系統防護
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__APP_DIR__

[Install]
WantedBy=multi-user.target
